# Copy to .env for local development (`make dev`). Never commit real keys.
TRAVO_DATABASE_URL=postgresql+psycopg://travo_api:travo_api@localhost:5432/travo
TRAVO_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travo
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TRAVO_MASTER_KEY=
TRAVO_JWT_SECRET=
# Travo-billed endpoints are enabled only when their key is present:
# TRAVO_FIREWORKS_API_KEY=
# TRAVO_OPENROUTER_API_KEY=
# Run review workflows inside the API process after commit (dev only; production: make worker)
# TRAVO_INLINE_REVIEWS=true
# Accept tokens without a server-side session (mint-token / dev-token). MUST be false in any
# deployment holding client data (ADR-018).
# TRAVO_ALLOW_DEV_TOKENS=false
