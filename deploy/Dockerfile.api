# API and worker image (same image, different command). Build context: repository root.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
RUN pip install --no-cache-dir uv==0.8.17

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services ./services
COPY config ./config

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/services/api:/app/services/rag:/app/services/router:/app/services/agents \
    TRAVO_ENV=production \
    TRAVO_STORAGE_DIR=/data/objects \
    TRAVO_LEGAL_SNAPSHOT_DIR=/data/legal_snapshots

RUN useradd --system --uid 10001 travo && mkdir -p /data /backups && chown travo /data /backups
USER travo
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4)"

# Migrations run on every start (idempotent), then the API serves as the non-owner app role.
CMD ["sh", "-c", "python -m travo_api.cli migrate && exec uvicorn travo_api.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips '*'"]
