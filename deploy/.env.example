# Coolify → Environment Variables for the Travo compose app. Never commit real values.
# Generate each secret separately:
#   hex passwords (URL-safe):  openssl rand -hex 24
#   master key (base64 32 B):  openssl rand -base64 32
#   JWT secret:                openssl rand -hex 32
POSTGRES_PASSWORD=
TRAVO_APP_DB_PASSWORD=
TRAVO_MASTER_KEY=
TRAVO_JWT_SECRET=
TRAVO_PUBLIC_URL=https://app.example.vn
TRAVO_FETCH_CONTACT=legal-eng@example.vn
# Optional model provider keys (pay-per-token, ADR-022):
TRAVO_OPENROUTER_API_KEY=
TRAVO_FIREWORKS_API_KEY=
# Optional: UI language default (vi | en; users can switch) and sign-in attempts per IP/minute.
# TRAVO_DEFAULT_LOCALE=vi
# TRAVO_AUTH_RATE_LIMIT_PER_MINUTE=20
